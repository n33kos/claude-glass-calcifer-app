{
  "apiVersion": 1,
  "type": "calcifer",
  "title": "Calcifer",
  "icon": "icon.svg",
  "singleton": true,
  "autoOpen": false,
  "description": "Calcifer, a fire demon in his hearth: Claude's animated persona. He lip-syncs Claude's spoken replies, shows the mood behind them, and can be your whole voice channel.",
  "commands": {
    "mood": { "usage": "mood --mood <neutral|happy|grumpy|angry|sad|scared|thinking|sleepy|smug|excited|curious|focused|bored|proud|nervous|asleep> [--for <seconds>]", "help": "Set his expression (held until changed, or for --for seconds)" },
    "react": { "usage": "react --kind <flare|sputter|sparks|wince>", "help": "A one-shot reaction: flare up, sputter low, throw sparks, wince" },
    "mic": { "usage": "mic --mode <off|wake|open>", "help": "The user's mic: off, listening for his name, or open in a conversation" },
    "mute": { "usage": "mute --on <true|false>", "help": "Mute or unmute his voice (he still mouths the words)" },
    "terminal": { "usage": "terminal [--on <true|false|toggle>]", "help": "Open him up to the live tmux terminal in his core (the user can click him too), or close it" }
  },
  "permissions": { "microphone": true, "storage": true, "network": ["http://localhost:3100", "ws://localhost:3100"] },
  "stored": {
    "mic": { "scope": "project", "default": "off" },
    "calledAt": { "scope": "project", "default": 0 },
    "muted": { "scope": "global", "default": false },
    "health": { "scope": "global", "default": {} },
    "earStatus": { "scope": "global", "default": {} },
    "wakeStatus": { "scope": "global", "default": {} },
    "feedToken": { "scope": "global", "default": "" },
    "allowance": { "scope": "global", "default": {} }
  },
  "settings": {
    "persona": { "type": "bool", "label": "Claude speaks as Calcifer", "default": true },
    "micDevice": { "type": "audioinput", "label": "Microphone", "default": "" },
    "relayUrl": { "type": "text", "label": "Relay URL", "default": "http://localhost:3100" },
    "authToken": { "type": "text", "label": "Relay auth token", "default": "" },
    "terminalToken": { "type": "text", "label": "Terminal token (control scope)", "default": "" },
    "feedSession": { "type": "text", "label": "Session id", "default": "" },
    "wakeSensitivity": { "type": "number", "label": "Wake sensitivity (%)", "default": 50, "min": 0, "max": 100 },
    "voiceInterrupt": { "type": "bool", "label": "Say his name to interrupt him", "default": true },
    "quietSeconds": { "type": "number", "label": "Conversation timeout (seconds)", "default": 120, "min": 15, "max": 600 },
    "followUpSeconds": { "type": "number", "label": "Follow-up window (seconds)", "default": 4, "min": 0, "max": 30 },
    "commandWisps": { "type": "bool", "label": "Show what he's working on", "default": true },
    "commandWispSize": { "type": "number", "label": "Wisp size (%)", "default": 100, "min": 50, "max": 200 },
    "subtitles": { "type": "bool", "label": "Subtitles", "default": false },
    "subtitleSize": { "type": "number", "label": "Subtitle size (%)", "default": 100, "min": 50, "max": 250 },
    "subtitleColor": { "type": "color", "label": "Subtitle color", "default": "#fff3cf" },
    "stepRate": { "type": "number", "label": "Poses per second", "default": 12, "min": 0, "max": 60 },
    "hearth": { "type": "bool", "label": "Draw the fireplace", "default": true },
    "sounds": { "type": "bool", "label": "Sound effects", "default": true },
    "ambience": { "type": "bool", "label": "Crackling hearth", "default": true },
    "soundVolume": { "type": "number", "label": "Sound volume (%)", "default": 35, "min": 0, "max": 100 }
  }
}
